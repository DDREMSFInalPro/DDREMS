# Server
PORT=5000
NODE_ENV=development

# PostgreSQL Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ddrems
DB_USER=postgres
DB_PASSWORD=your_password_here

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# AI Price Recommendation Service
AI_SERVICE_URL=http://localhost:8000/api/predict-price

# File Uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880
